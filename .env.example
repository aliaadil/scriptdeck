# Kindling configuration. Values shown are loader-recognized defaults;
# override only the ones you want to change.

# SQLite file path. Backup this one file.
KINDLING_DB_PATH=./data/kindling.db

# Per-script source + per-run logs live here.
KINDLING_STORAGE_DIR=./storage

# Bind address (set to 0.0.0.0 if fronted by a reverse proxy).
KINDLING_HOST=127.0.0.1

# TCP port.
KINDLING_PORT=8765

# Required secrets — Kindling hard-fails on boot if either is missing.
# Generate a 32-byte random key with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
KINDLING_JWT_SECRET=
KINDLING_ENV_ENCRYPTION_KEY=

# Optional. Format: username:bcrypt_hash. Enables HTTP Basic auth.
# KINDLING_BASIC_AUTH=
