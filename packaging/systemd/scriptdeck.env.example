# /etc/scriptdeck/scriptdeck.env — example EnvironmentFile for the systemd unit.
# Copy to /etc/scriptdeck/scriptdeck.env on the host, then `chmod 600` and
# `chown root:scriptdeck` so only root and the service user can read it.
# Override anything here per-deployment.

# Persistent state — point at a durable, backed-up location.
SCRIPTDECK_DB_PATH=/var/lib/scriptdeck/scriptdeck.db
SCRIPTDECK_STORAGE_DIR=/var/lib/scriptdeck/storage

# Listener. 127.0.0.1 if fronted by a reverse proxy; 0.0.0.0 for direct.
SCRIPTDECK_HOST=127.0.0.1
SCRIPTDECK_PORT=8765

# Optional. Generate with:
#   htpasswd -nbBC 12 "" "your-password" | tr -d ':\n' | sed 's/\$2y\$/\$2a\$/'
# Leave commented out to disable auth (local-only bind assumed).
# SCRIPTDECK_BASIC_AUTH=user:bcrypt-hash